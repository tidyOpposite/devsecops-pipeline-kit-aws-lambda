terraform {
  required_version = ">= 1.10.5"
  backend "local" {}
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.72"
    }
  }
}

provider "aws" {
  region              = var.aws_region
  allowed_account_ids = [var.expected_account_id]
}

variable "expected_account_id" {
  type = string
  validation {
    condition     = can(regex("^[0-9]{12}$", var.expected_account_id))
    error_message = "Independently confirm the 12-digit deployment AWS account ID."
  }
}

variable "aws_region" {
  type = string
  validation {
    condition     = can(regex("^[a-z]{2}-[a-z]+-[0-9]$", var.aws_region))
    error_message = "Supply an explicit commercial AWS region."
  }
}

variable "project_name" {
  type = string
  validation {
    condition     = can(regex("^kit-(lab-)?[a-z][a-z0-9-]{2,15}-[a-f0-9]{6}$", var.project_name))
    error_message = "Use the unique project prefix generated by devsecops init."
  }
}

variable "purpose" {
  type    = string
  default = "Deployment"
  validation {
    condition     = contains(["Deployment", "SingleOperatorLab"], var.purpose)
    error_message = "Use Deployment, or preserve the ownership tag of a migrated deployment."
  }
}

variable "lambda_image_uri" {
  type    = string
  default = ""
}

variable "reserved_concurrency" {
  type    = number
  default = 10
  validation {
    condition     = var.reserved_concurrency == -1 || (var.reserved_concurrency >= 1 && var.reserved_concurrency <= 1000 && floor(var.reserved_concurrency) == var.reserved_concurrency)
    error_message = "Deployment concurrency must be -1 (explicit shared-pool mode) or an integer from 1 to 1000. Zero disables invocations and is not a deployment mode."
  }
}

locals {
  name_prefix = "${var.project_name}-dev"
  tags = {
    Project     = var.project_name
    Environment = "dev"
    Purpose     = var.purpose
    ManagedBy   = "Terraform"
  }
}

module "kms" {
  source                    = "./modules/kms"
  account_id                = var.expected_account_id
  aws_region                = var.aws_region
  environment               = "dev"
  name_prefix               = local.name_prefix
  project_name              = var.project_name
  terraform_admin_role_name = ""
  tags                      = local.tags
}

module "ecr" {
  source      = "./modules/ecr"
  kms_key_arn = module.kms.key_arn
  name_prefix = local.name_prefix
  tags        = local.tags
}

module "storage" {
  source      = "./modules/storage"
  account_id  = var.expected_account_id
  kms_key_arn = module.kms.key_arn
  name_prefix = local.name_prefix
  tags        = local.tags
}

module "lambda" {
  source                         = "./modules/lambda"
  environment                    = "dev"
  kms_key_arn                    = module.kms.key_arn
  lambda_image_uri               = var.lambda_image_uri
  lambda_memory_size             = 512
  lambda_timeout                 = 15
  log_retention_days             = 7
  name_prefix                    = local.name_prefix
  output_bucket_arn              = module.storage.output_bucket_arn
  output_bucket_name             = module.storage.output_bucket_name
  reserved_concurrent_executions = var.reserved_concurrency
  tags                           = local.tags
}

module "api_gateway" {
  source                     = "./modules/api-gateway"
  authorization_type         = "AWS_IAM"
  api_throttling_burst_limit = 10
  api_throttling_rate_limit  = 5
  cors_allowed_origins       = ["https://localhost"]
  kms_key_arn                = module.kms.key_arn
  lambda_invoke_arn          = module.lambda.invoke_arn
  log_retention_days         = 7
  name_prefix                = local.name_prefix
  tags                       = local.tags
}

resource "aws_lambda_permission" "api_gw_permission" {
  statement_id  = "AllowAPIGatewayInvoke"
  action        = "lambda:InvokeFunction"
  function_name = module.lambda.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${module.api_gateway.execution_arn}/*/*"
}

output "deployment_context" {
  value = {
    purpose              = var.purpose
    environment          = "dev"
    account_id           = var.expected_account_id
    region               = var.aws_region
    project_name         = var.project_name
    repository_url       = module.ecr.repository_url
    output_bucket_name   = module.storage.output_bucket_name
    log_bucket_name      = module.storage.log_bucket_name
    lambda_function_arn  = module.lambda.function_arn
    lambda_function_name = module.lambda.function_name
    image_uri            = module.lambda.image_uri
    api_endpoint         = module.api_gateway.api_endpoint
    reserved_concurrency = module.lambda.reserved_concurrency
  }
}

# Registry preparation targets ECR/KMS before a Lambda image exists. Keep this
# independent of the workload output, which is unknown during that first plan.
output "repository_url" {
  value = module.ecr.repository_url
}
